# Copy to .env and fill in your API key.
# .env is gitignored — never commit it.

# --- LLM Provider ---
# Pick one and fill in the key.

# Gemini — free key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# OpenRouter — free router, key at https://openrouter.ai
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
